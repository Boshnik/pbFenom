{
    "name": "pageblocks/fenom",
    "type": "library",
    "description": "pbFenom — hardened Fenom fork for PageBlocks (isolated namespace, security fixes, linear-time compiler)",
    "keywords": [
        "fenom",
        "template",
        "templating",
        "templater"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Ivan Shalganov",
            "email": "a.cobest@gmail.com",
            "role": "Original author"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "ext-tokenizer": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "pbFenom\\": "src/pbFenom"
        },
        "classmap": [
            "src/pbFenom.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/cases"
        ]
    }
}
